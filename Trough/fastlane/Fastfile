default_platform(:ios)

platform :ios do
  desc "Build, archive, and upload to TestFlight"
  lane :beta do
    # ── App Store Connect API auth ────────────────────────────────────────────
    # Option A (preferred): place the private key at fastlane/AuthKey_K34HFNJTXH.p8
    # Option B (CI/env):    set ASC_KEY_CONTENT to the raw .p8 file contents
    key_path = File.expand_path("AuthKey_K34HFNJTXH.p8", __dir__)

    api_key_params = {
      key_id:    "K34HFNJTXH",
      issuer_id: "69a6de84-f289-47e3-e053-5b8c7c11a4d1",
      duration:  1200,
      in_house:  false
    }

    if ENV["ASC_KEY_CONTENT"] && !ENV["ASC_KEY_CONTENT"].empty?
      api_key_params[:key_content] = ENV["ASC_KEY_CONTENT"]
    else
      api_key_params[:key_filepath] = key_path
    end

    api_key = app_store_connect_api_key(**api_key_params)

    # ── Code signing ─────────────────────────────────────────────────────────
    # Ensure a distribution certificate exists in the keychain. The app and the
    # TroughWidget extension both use Automatic signing; -allowProvisioningUpdates
    # plus the App Store Connect API key let xcodebuild register the widget App ID
    # (app.trough.ios.widget) + the App Group and generate both profiles.
    cert(
      api_key:       api_key,
      team_id:       "3N9RY9EG8V",
      output_path:   "build/certs"
    )

    # ── Build number ─────────────────────────────────────────────────────────
    # Version/build are set explicitly in the project (1.1.3 / 66); no auto-bump.

    # ── Archive ───────────────────────────────────────────────────────────────
    gym(
      scheme:           "Trough",
      project:          "Trough.xcodeproj",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build",
      output_name:      "Trough.ipa",
      clean:            true,
      disable_xcpretty: true,
      xcargs:           "-allowProvisioningUpdates " \
                        "-authenticationKeyID K34HFNJTXH " \
                        "-authenticationKeyIssuerID 69a6de84-f289-47e3-e053-5b8c7c11a4d1 " \
                        "-authenticationKeyPath #{key_path} " \
                        "DEVELOPMENT_TEAM=3N9RY9EG8V",
      export_options:   {
        method:       "app-store",
        signingStyle: "automatic",
        teamID:       "3N9RY9EG8V"
      }
    )

    # ── Upload ────────────────────────────────────────────────────────────────
    upload_to_testflight(
      api_key:                           api_key,
      app_identifier:                    "app.trough.ios",
      apple_id:                          "6760955550",
      skip_waiting_for_build_processing: true,
      distribute_external:               false
    )
  end

  desc "Upload localized metadata + screenshots (drafts only, no submission)"
  lane :metadata do
    key_path = File.expand_path("AuthKey_K34HFNJTXH.p8", __dir__)
    api_key = app_store_connect_api_key(
      key_id:    "K34HFNJTXH",
      issuer_id: "69a6de84-f289-47e3-e053-5b8c7c11a4d1",
      duration:  1200,
      in_house:  false,
      key_filepath: key_path
    )

    deliver(
      api_key:                  api_key,
      app_identifier:           "app.trough.ios",
      metadata_path:            "./fastlane/metadata",
      screenshots_path:         "./fastlane/screenshots",
      skip_binary_upload:       true,
      skip_app_version_update:  false,
      overwrite_screenshots:    true,
      force:                    true,          # no HTML preview / confirmation prompt
      submit_for_review:        false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end
end
